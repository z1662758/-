# 高德地图API密钥
# 申请地址: https://console.amap.com/dev/key/app
VITE_AMAP_KEY=your-amap-key-here
VITE_AMAP_SECURITY_CODE=your-security-code-here

# 后端 HTTP 根（可选；开发时多数接口走 Vite 代理 /api）
VITE_API_BASE_URL=http://localhost:9091

# Socket.IO 直连根地址（与 Flask-SocketIO 端口一致；不设则依次回退 VITE_APP_BASE_API、VITE_API_BASE_URL）
# VITE_SOCKET_BASE_URL=http://localhost:9091

# 历史兼容名，部分代码仍读取
# VITE_APP_BASE_API=http://localhost:9091
